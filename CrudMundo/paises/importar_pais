<?php
include '../includes/auth.php';
require_once '../config/api.php';
require_once '../includes/conexao_pdo.php';

$mensagem = '';
$sucesso = false;
$paisImportado = null;
$modoDemo = false;

if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
    http_response_code(405);
    $mensagem = 'Acesse esta página pelo formulário de importação.';
} else {
    $nomeBusca = trim($_POST['pais'] ?? '');
    $tamanhoNome = function_exists('mb_strlen') ? mb_strlen($nomeBusca, 'UTF-8') : strlen($nomeBusca);

    if ($nomeBusca === '') {
        $mensagem = 'Informe o nome de um país.';
    } elseif ($tamanhoNome > 100) {
        $mensagem = 'O nome informado excede o limite de 100 caracteres.';
    } elseif (!function_exists('curl_init')) {
        $mensagem = 'A extensão cURL do PHP não está habilitada.';
    } else {
        try {
            $url = 'https://api.restcountries.com/countries/v5/names.common/' . rawurlencode($nomeBusca);
            $curl = curl_init($url);

            if ($curl === false) {
                throw new RuntimeException('Não foi possível iniciar a consulta à API.');
            }

            curl_setopt_array($curl, [
                CURLOPT_RETURNTRANSFER => true,
                CURLOPT_HTTPGET => true,
                CURLOPT_CONNECTTIMEOUT => 5,
                CURLOPT_TIMEOUT => 15,
                CURLOPT_SSL_VERIFYPEER => true,
                CURLOPT_SSL_VERIFYHOST => 2,
                CURLOPT_HTTPHEADER => [
                    'Authorization: Bearer ' . $apiKey,
                    'Accept: application/json',
                ],
            ]);

            $resposta = curl_exec($curl);
            $statusHttp = (int) curl_getinfo($curl, CURLINFO_HTTP_CODE);
            $erroCurl = curl_error($curl);
            curl_close($curl);

            if ($resposta === false) {
                error_log('Erro cURL REST Countries: ' . $erroCurl);
                throw new RuntimeException('Não foi possível se comunicar com a API. Tente novamente.');
            }

            if ($statusHttp === 404) {
                throw new RuntimeException('Nenhum país foi encontrado com esse nome.');
            }

            if ($statusHttp === 401 || $statusHttp === 403) {
                throw new RuntimeException('A API recusou a chave configurada. Confira REST_COUNTRIES_API_KEY no .env.');
            }

            if ($statusHttp !== 200) {
                error_log('Resposta HTTP da REST Countries: ' . $statusHttp);
                throw new RuntimeException('A API retornou um erro. Tente novamente mais tarde.');
            }

            $dados = json_decode($resposta, true, 512, JSON_THROW_ON_ERROR);
            $modoDemo = !empty($dados['data']['_demo']);
            $paisApi = $dados['data']['objects'][0] ?? null;

            if (!is_array($paisApi)) {
                throw new RuntimeException('A resposta da API não contém dados válidos de país.');
            }

            $nome = $paisApi['names']['common'] ?? null;
            $codigoIso = $paisApi['codes']['alpha_2'] ?? null;
            $capitalApi = $paisApi['capitals'][0] ?? null;
            $capital = is_array($capitalApi) ? ($capitalApi['name'] ?? null) : $capitalApi;
            $populacao = $paisApi['population'] ?? null;
            $regiao = $paisApi['region'] ?? null;
            $subRegiao = $paisApi['subregion'] ?? null;

            if (!is_string($nome) || trim($nome) === '' || !is_string($codigoIso)
                || !preg_match('/^[A-Z]{2}$/', $codigoIso)) {
                throw new RuntimeException('A API não retornou nome e código ISO válidos para o país.');
            }

            $limiteTexto = static function ($valor, string $campo): ?string {
                if ($valor === null || $valor === '') {
                    return null;
                }
                if (!is_string($valor)) {
                    return null;
                }
                $tamanho = function_exists('mb_strlen') ? mb_strlen($valor, 'UTF-8') : strlen($valor);
                if ($tamanho > 100) {
                    throw new RuntimeException('O campo ' . $campo . ' recebido da API excede 100 caracteres.');
                }
                return $valor;
            };

            $capital = $limiteTexto($capital, 'capital');
            $regiao = $limiteTexto($regiao, 'região');
            $subRegiao = $limiteTexto($subRegiao, 'sub-região');

            if ($populacao !== null && (!is_int($populacao) || $populacao < 0)) {
                throw new RuntimeException('A API retornou um valor de população inválido.');
            }

            $verificar = $pdo->prepare(
                'SELECT id_pais FROM paises
                 WHERE codigo_iso = :codigo_iso
                    OR (codigo_iso IS NULL AND LOWER(nome) = LOWER(:nome))
                 LIMIT 1'
            );
            $verificar->execute([
                ':codigo_iso' => $codigoIso,
                ':nome' => $nome,
            ]);

            if ($verificar->fetch()) {
                throw new RuntimeException('Este país já está cadastrado no sistema.');
            }

            $inserir = $pdo->prepare(
                'INSERT INTO paises (nome, codigo_iso, capital, populacao, regiao, sub_regiao)
                 VALUES (:nome, :codigo_iso, :capital, :populacao, :regiao, :sub_regiao)'
            );
            $inserir->bindValue(':nome', $nome, PDO::PARAM_STR);
            $inserir->bindValue(':codigo_iso', $codigoIso, PDO::PARAM_STR);
            $inserir->bindValue(':capital', $capital, $capital === null ? PDO::PARAM_NULL : PDO::PARAM_STR);
            $inserir->bindValue(':populacao', $populacao, $populacao === null ? PDO::PARAM_NULL : PDO::PARAM_INT);
            $inserir->bindValue(':regiao', $regiao, $regiao === null ? PDO::PARAM_NULL : PDO::PARAM_STR);
            $inserir->bindValue(':sub_regiao', $subRegiao, $subRegiao === null ? PDO::PARAM_NULL : PDO::PARAM_STR);
            $inserir->execute();

            $paisImportado = [
                'id' => (int) $pdo->lastInsertId(),
                'nome' => $nome,
                'codigo_iso' => $codigoIso,
                'capital' => $capital,
                'populacao' => $populacao,
                'regiao' => $regiao,
                'sub_regiao' => $subRegiao,
            ];
            $mensagem = $modoDemo
                ? 'A API retornou um registro de demonstração, que foi cadastrado. Esse resultado pode não corresponder ao país pesquisado.'
                : 'País consultado e cadastrado com sucesso.';
            $sucesso = true;
        } catch (PDOException $erro) {
            error_log('Erro PDO ao importar país: ' . $erro->getMessage());
            $mensagem = 'Não foi possível gravar o país no banco de dados. Verifique a estrutura da tabela paises.';
        } catch (JsonException $erro) {
            error_log('JSON inválido recebido da REST Countries: ' . $erro->getMessage());
            $mensagem = 'A API retornou uma resposta que não pôde ser interpretada.';
        } catch (Throwable $erro) {
            $mensagem = $erro->getMessage();
        }
    }
}

function e(string $valor): string
{
    return htmlspecialchars($valor, ENT_QUOTES, 'UTF-8');
}
